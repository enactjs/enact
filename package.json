{
  "name": "enact",
  "version": "5.6.0",
  "description": "Monorepo for all Enact front end libraries.",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "lerna": "lerna",
    "bootstrap": "pnpm install",
    "bootstrap-link": "pnpm install && pnpm run link-all",
    "link-all": "pnpm -r --filter '!enact-sampler' --workspace-concurrency=1 exec npm --loglevel error --no-package-lock link",
    "unlink-all": "pnpm -r --filter '!enact-sampler' --workspace-concurrency=1 exec npm --loglevel error --no-package-lock unlink --global",
    "publish": "lerna publish --skip-npm --skip-git",
    "lint": "pnpm -r --if-present --workspace-concurrency=1 run lint",
    "test": "pnpm -r --if-present --workspace-concurrency=1 run test",
    "test-ss": "pnpm -r --if-present --workspace-concurrency=1 run test-ss",
    "test-ui": "pnpm -r --if-present --workspace-concurrency=1 run test-ui",
    "clean": "lerna clean",
    "validate-docs": "validate-docs --strict --standalone --path packages"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@enact/docs-utils": "^0.5.0",
    "lerna": "^9.0.7"
  }
}
