{
  "name": "enact",
  "version": "5.7.0",
  "description": "Monorepo for all Enact front end libraries.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');['i18n','ui'].forEach(d=>{const t=p.join('packages',d,'node_modules','ilib');if(!fs.existsSync(t)){fs.mkdirSync(p.dirname(t),{recursive:true});fs.symlinkSync(p.resolve('node_modules','ilib'),t)}})\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test-ss": "npm run test-ss --workspaces --if-present",
    "test-ui": "npm run test-ui --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "validate-docs": "validate-docs --strict --standalone --path packages"
  },
  "license": "Apache-2.0",
  "overrides": {
    "autolinker": "^4.0.0",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.15",
    "vue-template-compiler": "@vue/compiler-sfc@3.4.31",
    "fork-ts-checker-webpack-plugin": {
      "minimatch": "^11.0.1"
    },
    "webpack-dev-middleware": "^7.4.5"
  },
  "devDependencies": {
    "@enact/docs-utils": "^0.5.0"
  }
}