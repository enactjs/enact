{
  "name": "enact",
  "version": "5.7.0",
  "description": "Monorepo for all Enact front end libraries.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test-ss": "npm run test-ss --workspaces --if-present",
    "test-ui": "npm run test-ui --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "validate-docs": "validate-docs --strict --standalone --path packages"
  },
  "license": "Apache-2.0",
  "overrides": {
    "autolinker": "^4.0.0",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.15",
    "vue-template-compiler": "@vue/compiler-sfc@3.4.31"
  },
  "devDependencies": {
    "@enact/docs-utils": "^0.5.0"
  }
}